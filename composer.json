{
    "name": "katabaticwx/symfony-skel",
    "description": "A minimal Symfony project recommended to create bare bones applications",
    "version": "0.0.1",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "nyrodev/php-template-bundle": "dev-master",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4.0.1",
        "symfony/runtime": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/templating": "7.0.x-dev",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "wrpn/powerform-php": "dev-master"
    },
    "require-dev": {
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/kremit/powerform-php"}
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "weatherUSA\\PHPUtil\\": "lib/PHPUtil/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cache-clear": [
            "@php bin/console cache:clear",
            "@fix-var-perms"
        ],
        "fix-var-perms": "sudo chown -R apache:apache var/"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false
        }
    }
}
